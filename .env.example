# Discord Bot Zugangsdaten (Discord Developer Portal)
DISCORD_TOKEN=
CLIENT_ID=

# Optional: Guild-ID für schnelles Registrieren der Slash-Commands
# während der Entwicklung (Änderungen sofort sichtbar, nur in diesem Server).
# Leer lassen für globale Registrierung (Rollout dauert bis zu 1 Stunde).
GUILD_ID=

# Pfad zur SQLite-Datenbankdatei.
# Lokal reicht der Standardwert. Auf Railway auf einen gemounteten
# Volume-Pfad zeigen (z. B. /data/founderclock.sqlite), damit die
# Daten Deployments überleben.
DB_PATH=./data/founderclock.sqlite

# Standard-Stundensatz für die Anteilsberechnung (in Standardwährung).
DEFAULT_HOURLY_RATE=25

# Standardwährung für Ausgaben und Anteilsberechnung.
DEFAULT_CURRENCY=EUR
